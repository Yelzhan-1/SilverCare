# Public client config (safe in the browser). Never put service_role here.
# Copy this file to `.env` and fill in values from the Supabase project settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional — next sprint (Web Push). Public VAPID only.
# VITE_VAPID_PUBLIC_KEY=

# Server-only secrets — Edge Functions / CI, never Vite / frontend.
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PRIVATE_KEY=
