# Copy to .env and fill values. Never commit .env.
#
# Required at BUILD time (Vite inlines VITE_* into the bundle).
# `npm run build` / `npm run dev` fail if any of these are empty,
# placeholder, or the wrong shape.
#
# Vercel: Project Settings → Environment Variables
# (Production, Preview, Development), then Redeploy.
# Never put service_role / secret keys in Vite or the repo.

# https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Anon/publishable JWT starting with eyJ — NEVER service_role
VITE_SUPABASE_ANON_KEY=

# Web Push (public only in the browser bundle)
VITE_VAPID_PUBLIC_KEY=

# Edge Function secrets (set via `supabase secrets set`, NOT in Vite):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
