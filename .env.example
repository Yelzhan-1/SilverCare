# Copy to .env and fill values. Never commit .env.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (public only in the browser bundle)
VITE_VAPID_PUBLIC_KEY=

# Edge Function secrets (set via `supabase secrets set`, NOT in Vite):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
